# ------------------------------------------------------------------
# Blood Connect - environment configuration
# Copy this file to `.env` and adjust the values for your machine.
# ------------------------------------------------------------------

# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Flask
FLASK_APP=run.py
FLASK_DEBUG=1

# PostgreSQL (recommended / required for production)
# DATABASE_URL=postgresql+psycopg://blood_user:blood_pass@localhost:5432/blood_connect
#
# If DATABASE_URL is omitted the app falls back to a local SQLite file
# (instance/blood_connect.db) so you can try it without installing Postgres.
DATABASE_URL=

# Timezone used when rendering timestamps
APP_TIMEZONE=UTC

# Donation cooldown in days (90 is the WHO-aligned safe interval)
DONATION_COOLDOWN_DAYS=90

# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0
REMEMBER_COOKIE_SECURE=0

# Rate limiting (1 enables, 0 disables; e.g. during load testing)
RATELIMIT_ENABLED=1

# Support contact shown in the interface
SUPPORT_EMAIL=support@example.com
